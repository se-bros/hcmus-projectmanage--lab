graph TD
    subgraph ClientLayer ["Lớp Giao diện (Client Layer)"]
        UI[Next.js Frontend Web App]
        Reader[EPUB Reader Component]
        UI --- Reader
    end
    
    subgraph AppLayer ["Lớp Ứng dụng (Application Layer - FastAPI Python)"]
        API[FastAPI Core API Gateway]
        ModAuth[Module Auth & RBAC]
        ModDoc[Module Document & Metadata]
        ModBorrow[Module Mượn/Trả]
        ModStat[Module Thống kê Báo cáo]
        ModChat[Module Chatbot RAG]
        
        API --- ModAuth
        API --- ModDoc
        API --- ModBorrow
        API --- ModStat
        API --- ModChat
    end
    
    subgraph QueueLayer ["Hàng đợi Tác vụ (Queue Layer)"]
        MQ[Redis / RabbitMQ Task Queue]
    end

    subgraph WorkerLayer ["Lớp Xử lý Nặng (Workers Layer)"]
        OCRWorker[Tesseract OCR Worker]
        ConvWorker[Calibre EPUB Converter]
    end

    subgraph DataLayer ["Lớp Dữ liệu & Lưu trữ (Data Layer)"]
        DB[(PostgreSQL CSDL & File Storage)]
        Search[(Elasticsearch Engine)]
    end
    
    UI -->|HTTP / REST API| API
    API --> DB
    API --> Search
    API --> MQ
    MQ --> OCRWorker
    MQ --> ConvWorker
    OCRWorker --> DB
    ConvWorker --> DB
    OCRWorker --> Search
    
    style ClientLayer fill:#f9f,stroke:#333;
    style AppLayer fill:#bbf,stroke:#333;
    style QueueLayer fill:#ffd2e8,stroke:#333;
    style WorkerLayer fill:#fbb,stroke:#333;
    style DataLayer fill:#bfb,stroke:#333;
