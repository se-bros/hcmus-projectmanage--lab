graph TD
    subgraph ClientLayer ["Lớp Giao diện (Client Layer)"]
        UI[Custom Frontend - Portal HCMUS]
    end
    
    subgraph AppLayer ["Lớp Ứng dụng (Application Layer - Modular Monolith)"]
        Core[DSpace / Invenio Core Engine]
        SubWork[Module Nộp & Duyệt]
        SubMeta[Module Quản lý Metadata]
        SubAccess[Module Phân quyền Access Control]
        
        Core --- SubWork
        Core --- SubMeta
        Core --- SubAccess
    end
    
    subgraph DataLayer ["Lớp Dữ liệu & Dịch vụ Vệ tinh"]
        DB[(PostgreSQL CSDL)]
        Search[(Elasticsearch / OpenSearch)]
        Storage[(Object Storage - File & Backup)]
    end
    
    subgraph ExternalLayer ["Hệ thống Tích hợp & Nâng cao"]
        SSO[Xác thực SSO / LDAP]
        AI[Dịch vụ AI / RAG - Giai đoạn 3]
    end
    
    UI -->|HTTP / API| Core
    Core --> DB
    Core --> Search
    Core --> Storage
    Core --> SSO
    Core -.-> AI
    
    style ClientLayer fill:#f9f,stroke:#333;
    style AppLayer fill:#bbf,stroke:#333;
    style DataLayer fill:#bfb,stroke:#333;
    style ExternalLayer fill:#fbb,stroke:#333;
