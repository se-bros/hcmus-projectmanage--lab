APP_ENV=development

# --- docker-compose.yml để khởi tạo container postgres/minio ---
POSTGRES_USER=ldms
POSTGRES_PASSWORD=ldms
POSTGRES_DB=ldms
MINIO_ROOT_USER=ldms
MINIO_ROOT_PASSWORD=ldms12345
MINIO_BUCKET=ldms

# --- astAPI (app/core/config.py) ---
DATABASE_URL=postgresql+psycopg://ldms:ldms@localhost:5434/ldms
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=ldms
MINIO_SECRET_KEY=ldms12345
CORS_ORIGINS=["http://localhost:5173"]
OCR_DPI=300
OCR_LANGUAGE=vie+eng
OCR_TIMEOUT_SECONDS=60
PDF_RENDER_TIMEOUT_SECONDS=120
PANDOC_TIMEOUT_SECONDS=120

# --- Identity & Access (LDMS-009/010/018) ---
AUTH_MODE=mock
JWT_SECRET=dev-insecure-secret-change-me-min-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback/google
GOOGLE_ALLOWED_DOMAINS=["hcmus.edu.vn"]
FRONTEND_BASE_URL=http://localhost:5173
